{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://${BACKEND_EC2_IP:-10.0.2.100}:5342"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "ApplicationName": "ApiGateway"
    }
  },
  "AllowedHosts": "*",
  "BackendServices": {
    "AuthAPI": {
      "Host": "${AUTH_API_HOST}",
      "Port": "${AUTH_API_PORT}"
    },
    "ProductAPI": {
      "Host": "${PRODUCT_API_HOST}",
      "Port": "${PRODUCT_API_PORT}"
    },
    "CartAPI": {
      "Host": "${CART_API_HOST}",
      "Port": "${CART_API_PORT}"
    },
    "OrderAPI": {
      "Host": "${ORDER_API_HOST}",
      "Port": "${ORDER_API_PORT}"
    },
    "EmailAPI": {
      "Host": "${EMAIL_API_HOST}",
      "Port": "${EMAIL_API_PORT}"
    },
    "NotificationAPI": {
      "Host": "${NOTIFICATION_API_HOST}",
      "Port": "${NOTIFICATION_API_PORT}"
    }
  }
}