{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=BasketDb;Username=postgres;Password=postgres"
  },
  "AllowedHosts": "*",
  //"Kestrel": {
  //  "EndpointDefaults": {
  //    "Protocols": "Http2"
  //  }
  //},
  "MessageBroker": {
    "Host": "amqp://localhost:5672",
    "UserName": "guest",
    "Password": "guest"
  },
  "Authentication": {
    "Issuer": "https://localhost:7202",
    "Audience": "ecommerce.api",
    "RequireHttpsMetadata": false,
    "ClockSkewMinutes": 2,
    "EnableBearerHeaderPatch": true,
    "Jwks": {
      "Uri": "https://localhost:7202/.well-known/openid-configuration/jwks",
      "ValidAlgorithms": [ "RS256" ],
      "AllowInsecureDevCertificate": true
    },
    "ScopeClaimRequired": "ecommerce.api"
  },
  "Redis": {
    "Host": "localhost",
    "Port": "6379",
    "Password": "redispass123",
    "IsSSL": false,
    "Prefix": "ecommerce:dev:"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "nomic-embed-text",
    "TimeoutSeconds": 30
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200"
  },
  "Consul": {
    "Address": "http://localhost:8500"
  },
  "AWS": {
    "Region": "us-east-1",
    "BucketName": "amzn-s3-productcatalog"
  }
}
